pipeline {
    agent any

    parameters {
        password(name: 'GITHUB_TOKEN', defaultValue: '',
                description: '你自己的 GitHub token（classic，勾 repo 或不勾 scope）。只用於這次 build，不會存下來')
        string(name: 'CONFIG', defaultValue: 'people.json',
                description: 'people.json 的路徑（相對於 github/ 目錄）或 http(s) 網址，例如 gist 的 raw 連結')
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Run') {
            steps {
                // 快取放在 agent 使用者的 HOME 下，跨 build 共用；依 token 分開，
                // 因為帶 repo scope 的 token 會把私有 repo 的回應存進快取，不能跟別人共用
                dir('github') {
                    withEnv(["GITHUB_TOKEN=${params.GITHUB_TOKEN}"]) {
                        sh '''
                        set -e
                        if [ -z "${GITHUB_TOKEN}" ]; then
                            echo "請提供 GITHUB_TOKEN" >&2
                            exit 1
                        fi
                        export GH_ACTIVITY_CACHE="${HOME}/.cache/gh_activity/$(printf %s "${GITHUB_TOKEN}" | sha256sum | cut -c1-16)"
                        set +x
                        python3 gh_activity.py --config "${CONFIG}"
                    '''
                    }
                }
            }
        }
    }
}